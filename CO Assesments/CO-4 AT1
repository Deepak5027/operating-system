#include <stdlib.h>
#include <string.h>
 
#define MAX 100
 
int abs_val(int x) { return x < 0 ? -x : x; }
int cmp(const void *a, const void *b) { return (*(int*)a - *(int*)b); }
 
int cscan(int requests[], int n, int head, int diskSize, char *dir, int seq[]) {
    int sorted[MAX];
    for (int i = 0; i < n; i++) sorted[i] = requests[i];
    qsort(sorted, n, sizeof(int), cmp);
 
    int total = 0, current = head, count = 0, i;
    for (i = 0; i < n; i++) if (sorted[i] >= head) break;
 
    if (strcmp(dir, "right") == 0) {
        for (int j = i; j < n; j++) {
            seq[count++] = sorted[j];
            total += abs_val(sorted[j] - current);
            current = sorted[j];
        }
        total += abs_val((diskSize - 1) - current);
        total += (diskSize - 1); // wrap around to block 0
        current = 0;
        for (int j = 0; j < i; j++) {
            seq[count++] = sorted[j];
            total += abs_val(sorted[j] - current);
            current = sorted[j];
        }
    } else {
        for (int j = i - 1; j >= 0; j--) {
            seq[count++] = sorted[j];
            total += abs_val(sorted[j] - current);
            current = sorted[j];
        }
        total += current;              // travel to block 0
        total += (diskSize - 1);       // wrap around to last block
        current = diskSize - 1;
        for (int j = n - 1; j >= i; j--) {
            seq[count++] = sorted[j];
            total += abs_val(sorted[j] - current);
            current = sorted[j];
        }
    }
    return total;
}
 
int look(int requests[], int n, int head, char *dir, int seq[]) {
    int sorted[MAX];
    for (int i = 0; i < n; i++) sorted[i] = requests[i];
    qsort(sorted, n, sizeof(int), cmp);
 
    int total = 0, current = head, count = 0, i;
    for (i = 0; i < n; i++) if (sorted[i] >= head) break;
 
    if (strcmp(dir, "right") == 0) {
        for (int j = i; j < n; j++) {
            seq[count++] = sorted[j];
            total += abs_val(sorted[j] - current);
            current = sorted[j];
        }
        for (int j = i - 1; j >= 0; j--) {
            seq[count++] = sorted[j];
            total += abs_val(sorted[j] - current);
            current = sorted[j];
        }
    } else {
        for (int j = i - 1; j >= 0; j--) {
            seq[count++] = sorted[j];
            total += abs_val(sorted[j] - current);
            current = sorted[j];
        }
        for (int j = i; j < n; j++) {
            seq[count++] = sorted[j];
            total += abs_val(sorted[j] - current);
            current = sorted[j];
        }
    }
    return total;
}
 
void printSeq(int seq[], int n) {
    for (int i = 0; i < n; i++) printf("%d ", seq[i]);
    printf("\n");
}
 
int main() {
    int n, head, diskSize;
    char dir[10];
    int requests[MAX], seq1[MAX], seq2[MAX];
 
    printf("Enter number of disk requests: ");
    scanf("%d", &n);
    printf("Enter the disk request queue:\n");
    for (int i = 0; i < n; i++) scanf("%d", &requests[i]);
 
    printf("Enter initial head position: ");
    scanf("%d", &head);
 
    printf("Enter total disk size: ");
    scanf("%d", &diskSize);
 
    printf("Enter direction of head movement (left/right): ");
    scanf("%s", dir);
 
    int cscanTotal = cscan(requests, n, head, diskSize, dir, seq1);
    printf("\nC-SCAN Seek Sequence: ");
    printSeq(seq1, n);
    printf("C-SCAN Total Head Movement: %d\n", cscanTotal);
 
    int lookTotal = look(requests, n, head, dir, seq2);
    printf("\nLOOK Seek Sequence: ");
    printSeq(seq2, n);
    printf("LOOK Total Head Movement: %d\n", lookTotal);
 
    printf("\nConclusion:\n");
    if (lookTotal < cscanTotal)
        printf("LOOK performs better (%d vs %d) since it avoids traveling to the disk end unnecessarily.\n", lookTotal, cscanTotal);
    else if (cscanTotal < lookTotal)
        printf("C-SCAN performs better (%d vs %d) here, providing more uniform wait time despite extra travel.\n", cscanTotal, lookTotal);
    else
        printf("Both algorithms perform equally with total movement: %d\n", lookTotal);
 
    return 0;
}
q5:#include <stdio.h>
#include <stdlib.h>
 
#define MAX 100
 
int disk[MAX];
int abs_val(int x) { return x < 0 ? -x : x; }
 
int contiguousAllocation(int n, int fileSize, int allocated[]) {
    int start = -1, count = 0;
    for (int i = 0; i < n; i++) {
        if (disk[i] == 0) {
            if (start == -1) start = i;
            count++;
            if (count == fileSize) break;
        } else { start = -1; count = 0; }
    }
    if (count == fileSize && start != -1) {
        for (int i = 0; i < fileSize; i++) {
            disk[start + i] = 1;
            allocated[i] = start + i;
        }
        return fileSize;
    }
    return -1; // allocation failure
}
 
int indexedAllocation(int n, int fileSize, int allocated[]) {
    int indexBlock = -1;
    for (int i = 0; i < n; i++) if (disk[i] == 0) { indexBlock = i; break; }
    if (indexBlock == -1) return -1;
 
    int count = 0;
    for (int i = 0; i < n && count < fileSize; i++) {
        if (disk[i] == 0 && i != indexBlock) allocated[count++] = i;
    }
    if (count < fileSize) return -1;
 
    disk[indexBlock] = 1;
    for (int i = 0; i < count; i++) disk[allocated[i]] = 1;
    printf("(Index block used: %d)\n", indexBlock);
    return count;
}
 
int fcfs(int requests[], int n, int head, int seq[]) {
    int total = 0, current = head;
    for (int i = 0; i < n; i++) {
        seq[i] = requests[i];
        total += abs_val(requests[i] - current);
        current = requests[i];
    }
    return total;
}
 
int sstf(int requests[], int n, int head, int seq[]) {
    int visited[MAX] = {0};
    int current = head, total = 0;
    for (int i = 0; i < n; i++) {
        int minDist = 1000000000, minIndex = -1;
        for (int j = 0; j < n; j++) {
            if (!visited[j]) {
                int dist = abs_val(requests[j] - current);
                if (dist < minDist) { minDist = dist; minIndex = j; }
            }
        }
        visited[minIndex] = 1;
        seq[i] = requests[minIndex];
        total += minDist;
        current = requests[minIndex];
    }
    return total;
}
 
int main() {
    int n, fileSize, head, allocMethod, schedMethod;
    int requests[MAX], seq[MAX], allocated[MAX];
 
    printf("Enter total number of disk blocks: ");
    scanf("%d", &n);
    for (int i = 0; i < n; i++) disk[i] = 0;
 
    printf("Enter file size (number of blocks required): ");
    scanf("%d", &fileSize);
 
    printf("Choose allocation method (1-Contiguous, 2-Indexed): ");
    scanf("%d", &allocMethod);
 
    int allocCount;
    if (allocMethod == 1) {
        allocCount = contiguousAllocation(n, fileSize, allocated);
    } else if (allocMethod == 2) {
        allocCount = indexedAllocation(n, fileSize, allocated);
    } else {
        printf("Invalid allocation method.\n");
        return 1;
    }
 
    if (allocCount == -1) {
        printf("Error: File allocation failed. Insufficient space or fragmentation.\n");
        return 1;
    }
 
    printf("Allocated blocks: ");
    for (int i = 0; i < allocCount; i++) printf("%d ", allocated[i]);
    printf("\n");
 
    int reqCount;
    printf("Enter number of disk requests for scheduling: ");
    scanf("%d", &reqCount);
    printf("Enter disk request queue:\n");
    for (int i = 0; i < reqCount; i++) scanf("%d", &requests[i]);
 
    printf("Enter initial head position: ");
    scanf("%d", &head);
 
    printf("Choose disk scheduling method (1-FCFS, 2-SSTF): ");
    scanf("%d", &schedMethod);
 
    int totalSeek;
    if (schedMethod == 1) {
        totalSeek = fcfs(requests, reqCount, head, seq);
        printf("FCFS Seek Sequence: ");
    } else if (schedMethod == 2) {
        totalSeek = sstf(requests, reqCount, head, seq);
        printf("SSTF Seek Sequence: ");
    } else {
        printf("Invalid scheduling method.\n");
        return 1;
    }
 
    for (int i = 0; i < reqCount; i++) printf("%d ", seq[i]);
    printf("\nTotal Seek Time: %d\n", totalSeek);
 
    printf("\nSummary:\n");
    printf("Allocation Method: %s\n", allocMethod == 1 ? "Contiguous" : "Indexed");
    printf("Scheduling Method: %s\n", schedMethod == 1 ? "FCFS" : "SSTF");
    printf("Total Seek Time: %d\n", totalSeek);
    printf("Note: Re-run with the other allocation/scheduling combination to compare\n");
    printf("      and identify which pairing minimizes total seek time for this workload.\n");
 
    return 0;
}
